meta {
  name: Create Cart
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/carts
  body: none
  auth: none
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("cartId", res.body.id);
  }
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}

docs {
  CI smoke test step 1/3. Requires app started with --payment.failure-rate=0.0
  (or PAYMENT_FAILURE_RATE=0.0 env var) so checkout deterministically succeeds.
}
